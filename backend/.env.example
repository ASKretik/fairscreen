# Copy to backend/.env for local runs. On Render, set these as environment variables.

GEMINI_API_KEY=
# Model IDs are never hard-coded: copy them from the free-tier list on the AI Studio rate-limit page.
GEMINI_PARSE_MODEL=        # a Flash-Lite model (resume + JD parsing)
GEMINI_EVAL_MODEL=         # a Flash model (requirement evaluation)
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CONCURRENCY=2
# Attempts per call on rate limits / overload (default 5). Scripts can afford more, e.g. 8.
GEMINI_MAX_ATTEMPTS=
# Optional requests-per-minute caps per model (0 or empty = no cap). Set them a little under
# the free-tier RPM shown in AI Studio; eval/run_eval.py and build_demo.py rely on them.
GEMINI_PARSE_RPM=
GEMINI_EVAL_RPM=
GEMINI_EMBED_RPM=

FIREBASE_SERVICE_ACCOUNT_B64=   # base64 -i key.json | tr -d '\n'
ALLOWED_ORIGINS=https://askretik.github.io,https://<project>.web.app,http://localhost:5173

MAX_FILES_PER_UPLOAD=20
MAX_FILE_MB=5
MAX_CANDIDATES_PER_JOB=50
