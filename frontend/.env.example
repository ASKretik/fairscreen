VITE_API_URL=https://<service>.onrender.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional. A production build without VITE_API_URL and the Firebase values runs demo-only (no sign-in).
# VITE_BASE=/fairscreen/     # sub-path hosting (GitHub Pages); the deploy workflow sets it
# VITE_REPO_URL=             # footer source-code link; the deploy workflow sets it
